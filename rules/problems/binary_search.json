
{
    "problem": {
        "name": "binary_search",
        "description": "Search for an element in a sorted sequence",
        "input_type": "size_and_key"
    },
    "correctness": {
        "test_file": "tests/binary_search_tests.json"
    },
    "logical_behavior": {
        "enabled": true,
        "cases": [
            {"name": "first_element", "input": "5\n0\n", "expected_output": "0\n"},
            {"name": "middle_element", "input": "5\n2\n", "expected_output": "2\n"},
            {"name": "last_element", "input": "5\n4\n", "expected_output": "4\n"},
            {"name": "element_not_found", "input": "5\n7\n", "expected_output": "-1\n"},
            {"name": "single_element_found", "input": "1\n0\n", "expected_output": "0\n"},
            {"name": "single_element_not_found", "input": "1\n5\n", "expected_output": "-1\n"},
            {"name": "negative_search_key", "input": "5\n-3\n", "expected_output": "-1\n"},
            {"name": "large_sequence_last_element", "input": "100\n99\n", "expected_output": "99\n"},
            {"name": "zero_search_key", "input": "10\n0\n", "expected_output": "0\n"}
        ]
    },
    "modularity": {
        "min_helper_functions": 1,
        "require_helper_calls": true
    },
    "complexity": {
        "required": "O(log n)",
        "enabled": true,
        "repetitions": 5,
        "benchmark_cases": [
            {
                "input_size": 1000000,
                "input": "1000000 999999 100000\n"
            },
            {
                "input_size": 10000000,
                "input": "10000000 9999999 100000\n"
            },
            {
                "input_size": 100000000,
                "input": "100000000 99999999 100000\n"
            },
            {
                "input_size": 1000000000,
                "input": "1000000000 999999999 100000\n"
            },
            {
                "input_size": 2000000000,
                "input": "2000000000 1999999999 100000\n"
            }
        ]
    }
}
